# ==============================================================================
# KrishiMitra Mobile / Web Frontend Environment Variables
# Location: mobile/.env
# Note: In Expo SDK, all client-exposed variables MUST have EXPO_PUBLIC_ prefix
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Backend API Base URL
# ------------------------------------------------------------------------------
# Default for web browser testing: http://localhost:8000/api/v1
# For physical phone testing with Expo Go, use your computer's local Wi-Fi IP:
# Example: EXPO_PUBLIC_API_URL=http://192.168.1.15:8000/api/v1
EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1

# ------------------------------------------------------------------------------
# 2. Google Maps API Key (Real Satellite & Street Maps)
# ------------------------------------------------------------------------------
# Get your API key from Google Cloud Console: https://console.cloud.google.com/
# Ensure "Maps JavaScript API" and "Maps Embed API" are enabled for Web
# Ensure "Maps SDK for Android" and "Maps SDK for iOS" are enabled for Native
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ------------------------------------------------------------------------------
# 3. Weather API (Direct client fallback if backend is offline)
# ------------------------------------------------------------------------------
# OpenWeatherMap API Key from: https://home.openweathermap.org/api_keys
EXPO_PUBLIC_OPENWEATHER_API_KEY=your_openweather_api_key_here

# ------------------------------------------------------------------------------
# 4. Mandi Prices API (Direct client fallback if backend is offline)
# ------------------------------------------------------------------------------
# Data.gov.in API Key from: https://data.gov.in/
EXPO_PUBLIC_DATA_GOV_IN_API_KEY=your_data_gov_in_api_key_here

# ------------------------------------------------------------------------------
# 5. Google Gemini API Key (KrishiMitra AI Farm Advisor - called directly from app)
# ------------------------------------------------------------------------------
# Get your free key at: https://aistudio.google.com/app/apikey
# The key starts with AIzaSy...
EXPO_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here
