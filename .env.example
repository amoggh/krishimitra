# ==============================================================================
# KrishiMitra - Global Environment Variables Reference
# ==============================================================================
# For backend variables: copy to backend/.env
# For frontend variables: copy to mobile/.env
# ==============================================================================

# --- Backend Keys (backend/.env) ---
DATA_GOV_IN_API_KEY=your_data_gov_in_api_key_here
OPENWEATHER_API_KEY=your_openweather_api_key_here
WEATHERAPI_KEY=
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# --- Mobile / Web Frontend Keys (mobile/.env) ---
EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
EXPO_PUBLIC_OPENWEATHER_API_KEY=your_openweather_api_key_here
EXPO_PUBLIC_DATA_GOV_IN_API_KEY=your_data_gov_in_api_key_here

