# ==============================================================================
# KrishiMitra Backend Environment Variables
# Location: backend/.env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Mandi Prices API (Government of India - AGMARKNET Portal)
# ------------------------------------------------------------------------------
# Get your free API key by signing up at: https://data.gov.in/
# Resource title: "Current Daily Price of Various Commodities from Various Markets (Mandi)"
# Catalog resource ID: 9ef84268-d588-465a-a308-a864a43d0070
DATA_GOV_IN_API_KEY=your_data_gov_in_api_key_here

# ------------------------------------------------------------------------------
# 2. Real-Time Weather Intelligence API
# ------------------------------------------------------------------------------
# Provider: OpenWeatherMap (Recommended)
# Sign up and get your free API key at: https://home.openweathermap.org/api_keys
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Alternative Weather Provider: WeatherAPI.com (Optional)
# If using WeatherAPI instead of OpenWeatherMap, paste your key below:
WEATHERAPI_KEY=

# ------------------------------------------------------------------------------
# 3. Google Maps API Key (Optional for backend geocoding / verification)
# ------------------------------------------------------------------------------
# Get your API key from Google Cloud Console: https://console.cloud.google.com/
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ------------------------------------------------------------------------------
# 4. Google Gemini API (KrishiMitra AI Farm Advisor Chatbot)
# ------------------------------------------------------------------------------
# Get your free Gemini API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 5. Server Configuration
# ------------------------------------------------------------------------------
CORS_ORIGINS=["*"]
