# Copy this file to server/.env and fill in your keys. Never commit server/.env.

# data.gov.in API key (free: https://www.data.gov.in, sign up, then "My Account" > API key).
# Without it the app uses the public demo key, which returns only 10 rows per call.
DATA_GOV_API_KEY=

# Farm assistant chat: any OpenAI-compatible endpoint serving an open-source model.
# Groq (open-weight):      LLM_BASE_URL=https://api.groq.com/openai/v1      LLM_MODEL=openai/gpt-oss-120b
# OpenRouter:              LLM_BASE_URL=https://openrouter.ai/api/v1        LLM_MODEL=meta-llama/llama-3.3-70b-instruct
# Together AI:             LLM_BASE_URL=https://api.together.xyz/v1         LLM_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo
# Ollama on this machine:  LLM_BASE_URL=http://localhost:11434/v1           LLM_MODEL=llama3.1   (leave LLM_API_KEY empty)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEY=

# Optional
LIVE_CACHE_SECONDS=1800
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
