# ------------------------------------------------------------------------------
# Dependencies & Package Managers
# ------------------------------------------------------------------------------
node_modules/
*/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*
.npm/

# ------------------------------------------------------------------------------
# Environment Variables & Local Secrets
# ------------------------------------------------------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
# Preserve environment templates/examples
!*.env.example
!*.env.template

# ------------------------------------------------------------------------------
# Python & Virtual Environments
# ------------------------------------------------------------------------------
__pycache__/
*/__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual Environments
.venv/
*/.venv/
venv/
*/venv/
env/
*/env/
ENV/
env.bak/
venv.bak/

