.pytest_cache/
*/.pytest_cache/
.coverage
.coverage.*
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
htmlcov/
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/

